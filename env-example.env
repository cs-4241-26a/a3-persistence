# Copy this file to .env and fill in real values for local development.
# On Render, set these as Environment Variables in the dashboard instead
# of committing a real .env file.

MONGODB_USERNAME="user-example"
MONGODB_PASSWORD="password-example"
MONGODB_URI="mongodb+srv://[username]:[password]@[cluster named in MongoDB Atlas].nigdili.mongodb.net/[database name]"
SESSION_SECRET=some-long-random-string
PORT=3000
